        <mxCell id="p1g0" value="Entidad: rectangulo, nombre en singular. Entidad debil: rectangulo doble. Relacion: rombo con un verbo. Relacion identificadora: rombo doble." style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1900" width="2200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1g1" value="Sobre el rombo va la razon de cardinalidad (1:1, 1:N, N:M). Junto a cada entidad va su participacion (minimo, maximo): el minimo 1 significa que toda instancia participa." style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1926" width="2200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1g2" value="Los catalogos cerrados (estado de salida, rol, tipo de incidencia y tipo de ruta) son entidades con valores fijos, como en el diseno estrategico. Un rombo nunca se une con otro rombo." style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1952" width="2200" height="22" as="geometry" />
        </mxCell>
